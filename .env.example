# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Connector API keys
# ---------------------------------------------------------------------------

# VA Facilities API — get a free key at https://developer.va.gov/
VA_API_KEY=your-va-facilities-api-key

# Google Places API (New) — Text Search, used by hoa/hoa_gmaps_enrich.py.
# Create a key at https://console.cloud.google.com/apis/credentials with the
# "Places API (New)" enabled. Only required when running hoa_gmaps_enrich.py.
GOOGLE_MAPS_API_KEY=your-google-places-api-key

# ---------------------------------------------------------------------------
# Local docker Postgres (docker-compose.yml)
# These three feed the postgres container's POSTGRES_* env vars.
# ---------------------------------------------------------------------------
POSTGRES_USER=ingest_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ingestion

# ---------------------------------------------------------------------------
# DATABASE_URL
# Store the BARE postgresql:// form. lib/db.get_engine() rewrites the scheme
# to postgresql+psycopg:// for SQLAlchemy (psycopg 3); db/run_migrations.py
# needs the bare form for libpq. URL-encode reserved chars in the password
# (e.g. '/' -> %2F).
#
# Local docker Postgres  -> port 5432:
#   DATABASE_URL=postgresql://ingest_app:change-me@localhost:5432/ingestion
# Cloud SQL via Auth Proxy -> run the proxy on 5433 so it never collides with
# local docker on 5432 (both bind 127.0.0.1):
#   cloud-sql-proxy --port 5433 juniper-crm-498215-p5:us-east1:juniper-postgres-prod
#   DATABASE_URL=postgresql://ingest_app:change-me@localhost:5433/ingestion
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://ingest_app:change-me@localhost:5432/ingestion

# ---------------------------------------------------------------------------
# GCS raw landing (D7)
# Default bucket is "juniper-ingest-raw" if GCS_RAW_BUCKET is unset.
# Set DISABLE_GCS=1 to skip uploads in local dev / CI (connectors degrade
# gracefully — never raise when GCS is disabled or ADC is absent).
# ---------------------------------------------------------------------------
GCS_RAW_BUCKET=juniper-ingest-raw
DISABLE_GCS=1

# ---------------------------------------------------------------------------
# NPPES flat-file paths (healthcare vertical only)
# NPPES bulk dissemination files are not fetched live — they must be
# downloaded manually from https://download.cms.gov/nppes/NPI_Files.html
# and either staged on a mounted volume or baked into a release image.
#
# Set these to glob patterns that expand to exactly one file each.
# Example (local):
#   NPPES_MAIN_GLOB=/data/nppes/npidata_pfile_20260810-20260816.csv
#   NPPES_PL_GLOB=/data/nppes/pl_pfile_20260810-20260816.csv
# ---------------------------------------------------------------------------
NPPES_MAIN_GLOB=/data/nppes/npidata_pfile_*.csv
NPPES_PL_GLOB=/data/nppes/pl_pfile_*.csv

# ---------------------------------------------------------------------------
# HOA flat-file paths (hoa vertical only)
# Source: https://data.texas.gov/dataset/TREC-HOA-Management-Certificates/8auc-hzdi
# Download and stage the CSV(s) before running. Glob accepted.
# ---------------------------------------------------------------------------
HOA_DATA_GLOB=/data/hoa/TREC_HOA_Management_Certificates_*.csv

# Optional: Census ZCTA-to-county relationship file to backfill county from ZIP.
# HOA_ZCTA_CROSSWALK=/data/hoa/zcta_county.csv

# Google Places enrichment concurrency (hoa_gmaps_enrich.py — be polite with rate limits).
HOA_GMAPS_WORKERS=4
HOA_GMAPS_RATE_PAUSE=0.2

# ---------------------------------------------------------------------------
# Resort flat-file paths (resort vertical only)
# Source: https://www.myfloridalicense.com/dbpr/sto/file_download/
# Seven district files: hrlodge1.csv .. hrlodge7.csv (weekly refresh, free).
# Glob accepted.
# ---------------------------------------------------------------------------
RESORT_DATA_GLOB=/data/resort/hrlodge*.csv

# Optional: override the minimum unit threshold (default is the connector's MIN_UNITS).
# RESORT_MIN_UNITS=25

# ---------------------------------------------------------------------------
# Deathcare optional overrides
# ---------------------------------------------------------------------------

# Space-separated two-letter state codes for USGS NSD (default: FL TX NC SC PA).
# USGS_STATES=FL TX NC SC PA

# Local IRS BMF files instead of live IRS URLs (space-separated paths).
# IRS_BMF_INPUTS=/data/deathcare/eo2.csv /data/deathcare/eo3.csv

# IRS 990 enrichment concurrency (ProPublica API — be polite with rate limits).
IRS_990_WORKERS=4
IRS_990_SLEEP=0.5

# ---------------------------------------------------------------------------
# Parks optional overrides
# ---------------------------------------------------------------------------

# This vertical needs NO credentials of any kind: every source is a public ArcGIS
# endpoint (Census TIGERweb, USGS PAD-US, PASDA, TPWD, FDEP, NCDPR, SCPRT).
# There is nothing to configure here for a normal run.

# Keep the intermediate per-source CSVs instead of writing them to a temp dir that
# is deleted on exit.  Useful for inspecting a run; note padus_parks.csv is ~17 MB.
# PARKS_OUT_DIR=outputs

# ---------------------------------------------------------------------------
# Cloud Run / Secret Manager (production only — not used in local dev)
# ---------------------------------------------------------------------------

# Cloud SQL instance connection name (used by run_*.sh when DATABASE_URL is absent).
# CLOUD_SQL_INSTANCE=juniper-crm-498215-p5:us-east1:juniper-postgres-prod

# DB decomposed fields — used by scripts to compose DATABASE_URL from the
# Secret Manager password when DATABASE_URL is not pre-set.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=ingest_app
# DB_NAME=ingestion
